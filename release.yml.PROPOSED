# Proposed replacement for .github/workflows/release.yml
#
# Why the current one fails every time:
#
#  1. prebuild.js (run automatically by npm's `prebuild` lifecycle hook before
#     `npm run build`) hard-exits 1 unless bin/ contains ffmpeg.exe >=30MB,
#     ffprobe.exe >=30MB and yt-dlp.exe >=5MB. Those ~170MB of binaries are
#     NOT in the repo - Download-Binaries.bat fetches them. On a fresh CI
#     checkout bin/ does not exist, so the build dies before electron-builder
#     ever starts. Identically. Every run. Which is what 10 consecutive
#     identical failures look like.
#
#  2. If the workflow instead CALLS Download-Binaries.bat, that script ends in
#     `pause` (line 114). On a runner with no keyboard that blocks until the
#     job times out. So calling the .bat is not a fix either.
#
# This workflow downloads the binaries inline in PowerShell - same sources and
# same size validation as the .bat, minus the interactive bits - then builds.
#
# Confirm the diagnosis first: open a failed run and look for the red banner
#     BUILD ABORTED - pre-build check failed
# If it is there, this is exactly it. If it is something else, send the log and
# ignore this file.

name: release

on:
  push:
    tags: ['v*']          # tag-driven releases
  workflow_dispatch:       # and a manual button

permissions:
  contents: write          # needed to create the GitHub Release

jobs:
  build-windows:
    # MUST be Windows: the targets are NSIS + portable .exe, and the bundled
    # binaries are .exe. This cannot cross-build from ubuntu.
    runs-on: windows-latest

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'

      # Cache the ~170MB of binaries so every run is not re-downloading them
      # from GitHub/gyan. Keyed on the downloader so it re-fetches if the
      # sources ever change.
      - name: Cache bundled binaries
        id: cache-bin
        uses: actions/cache@v4
        with:
          path: bin
          key: freqphull-bin-${{ hashFiles('Download-Binaries.bat') }}

      - name: Fetch yt-dlp + ffmpeg
        if: steps.cache-bin.outputs.cache-hit != 'true'
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'
          New-Item -ItemType Directory -Force -Path bin | Out-Null

          function Get-Validated($url, $out, $minBytes) {
            Write-Host "Downloading $url"
            try {
              Invoke-WebRequest -Uri $url -OutFile $out -UseBasicParsing -TimeoutSec 300
            } catch {
              Write-Host "  failed: $($_.Exception.Message)"
              return $false
            }
            if (-not (Test-Path $out)) { return $false }
            $size = (Get-Item $out).Length
            if ($size -lt $minBytes) {
              # A tiny file here is an HTML error page, not a binary.
              Write-Host "  too small: $size bytes (wanted >= $minBytes)"
              Remove-Item $out -Force
              return $false
            }
            Write-Host ("  ok - {0:N1} MB" -f ($size / 1MB))
            return $true
          }

          # yt-dlp: single source, straight to bin/
          if (-not (Get-Validated `
              'https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp.exe' `
              'bin/yt-dlp.exe' 10000000)) {
            throw 'yt-dlp download failed'
          }

          # ffmpeg: same two sources and order the .bat uses, BtbN then gyan.
          $zip = Join-Path $env:RUNNER_TEMP 'ffmpeg.zip'
          $ok = Get-Validated `
            'https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-master-latest-win64-gpl.zip' `
            $zip 50000000
          if (-not $ok) {
            Write-Host 'BtbN failed, trying gyan.dev'
            $ok = Get-Validated `
              'https://www.gyan.dev/ffmpeg/builds/ffmpeg-release-essentials.zip' `
              $zip 20000000
          }
          if (-not $ok) { throw 'both ffmpeg sources failed' }

          $extract = Join-Path $env:RUNNER_TEMP 'ffmpeg-extract'
          Expand-Archive -Path $zip -DestinationPath $extract -Force

          # Layout differs between the two sources, so search rather than
          # assume a path - same approach the .bat takes.
          foreach ($name in 'ffmpeg.exe', 'ffprobe.exe') {
            $found = Get-ChildItem $extract -Recurse -Filter $name | Select-Object -First 1
            if (-not $found) { throw "$name not found in the ffmpeg archive" }
            Copy-Item $found.FullName -Destination "bin/$name" -Force
            Write-Host ("copied {0} - {1:N1} MB" -f $name, ($found.Length / 1MB))
          }

      # electron-builder's `files` list names sentry.config.json explicitly.
      # Only the .example is committed, so create a inert one if absent rather
      # than letting the packer trip over a missing file.
      - name: Ensure sentry config exists
        shell: pwsh
        run: |
          if (-not (Test-Path 'sentry.config.json')) {
            if (Test-Path 'sentry.config.example.json') {
              Copy-Item 'sentry.config.example.json' 'sentry.config.json'
            } else {
              '{}' | Set-Content 'sentry.config.json'
            }
            Write-Host 'created sentry.config.json'
          }

      - name: Install dependencies
        run: npm ci

      # Run the gauntlet before shipping anything. A release that fails the
      # project's own 104 checks should not become a download.
      - name: Test suite
        shell: bash
        run: |
          for f in tools/test-*.js; do
            echo "== $f"
            node "$f" || exit 1
          done

      # `npm run build` triggers the `prebuild` hook automatically, which is
      # what validates bin/ and writes manifest.sha256.json.
      - name: Build installer
        run: npm run build

      - name: Upload build artifacts
        uses: actions/upload-artifact@v4
        with:
          name: freqphull-windows
          path: |
            dist/*.exe
            dist/*.blockmap
            dist/latest.yml
          if-no-files-found: error

      # Only publish on a tag. GITHUB_TOKEN is provided automatically; the
      # publish target in package.json points at CodePhull/FreqPhull-realease,
      # so that token needs write access to THAT repo - if it is a different
      # repo from this one, use a PAT in a secret instead.
      - name: Publish release
        if: startsWith(github.ref, 'refs/tags/v')
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: npx electron-builder --win --x64 --publish always
